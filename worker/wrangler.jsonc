{
  "name": "waternow-api-local",
  "main": "src/admin-auth.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "waternow-development",
    "database_id": "00000000-0000-4000-8000-000000000001"
  }],
  "vars": {
    "WATERNOW_ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8788",
    "APP_ORIGINS": "http://localhost:8788,http://127.0.0.1:8788,http://localhost:8787,http://127.0.0.1:8787"
  },
  "previews": {
    "vars": {
      "WATERNOW_ENVIRONMENT": "preview",
      "APP_ORIGIN": "https://waternow.pages.dev",
      "APP_ORIGINS": "https://waternow.pages.dev",
      "APP_ORIGIN_SUFFIXES": ".waternow.pages.dev"
    },
    "d1_databases": [{
      "binding": "DB",
      "database_name": "waternow-preview",
      "database_id": "62531d65-a4f0-45aa-b89a-d7d94cff177c",
      "migrations_dir": "migrations"
    }]
  }
}
